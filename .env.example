# SLOPGUARD Environment Configuration

# Server Configuration
SLOPGUARD_HOST=0.0.0.0
SLOPGUARD_PORT=8000
SLOPGUARD_LOG_LEVEL=info

# Registry Endpoints & Timeouts
PYPI_REGISTRY_URL=https://pypi.org/pypi
NPM_REGISTRY_URL=https://registry.npmjs.org
REGISTRY_TIMEOUT_SECONDS=8.0
REGISTRY_MAX_RETRIES=2

# Phantom Memory Storage Path
PHANTOM_STORAGE_PATH=./data/phantoms.json

# Policy Gate Strictness (lenient, standard, paranoid)
POLICY_MODE=standard
